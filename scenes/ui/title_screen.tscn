text = "Explore quatro biomas brasileiros procedurais. Monte uma criatura pequena e evasiva, colossal, social, predadora ou pacifista.\n\nGuardioes surgem em 03:00 e 06:00. Yawara desperta em 08:00. Genetics, Mutagen, raridades, Evolutions, Specialisations, Pressure e Endless mudam cada jornada."
autowrap_mode = 2
vertical_alignment = 1

