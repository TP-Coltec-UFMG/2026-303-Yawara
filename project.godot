; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ecos do Brasil: Yawara"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SettingsManager="*res://scripts/core/settings_manager.gd"
GameSession="*res://scripts/core/game_session.gd"
UpgradeDB="*res://scripts/core/upgrade_database.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
BiomeDB="*res://scripts/core/biome_database.gd"
WeaponDB="*res://scripts/core/weapon_database.gd"
StatDB="*res://scripts/core/stat_database.gd"
GeneticsDB="*res://scripts/core/genetics_database.gd"
CombatDB="*res://scripts/core/combat_database.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

